class Solution {
    public int[] buildArray(int[] nums) {
        int n = nums.length;

        // Store both old and new values in each element.
        for (int i = 0; i < n; i++) {
            nums[i] = nums[i] + (nums[nums[i]] % n) * n;
        }

        // Extract the new values.
        for (int i = 0; i < n; i++) {
            nums[i] /= n;
        }

        return nums;
    }
}
